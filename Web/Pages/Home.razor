@page "/"
@rendermode InteractiveServer
@using PersonDataManagementSystem.Application.Dtos
@using PersonDataManagementSystem.Application.Interfaces
@inject IPersonService PersonService

<PageTitle>Persons</PageTitle>

<FluentStack Orientation="Orientation.Vertical" VerticalGap="16">
    <FluentLabel Typo="Typography.Header">Persons</FluentLabel>

    <FluentButton Appearance="ButtonAppearance.Primary"
                  Disabled="@isLoading"
                  OnClick="LoadPersonsAsync">
        @(isLoading ? "Loading..." : "Load persons")
    </FluentButton>

    <FluentDataGrid TGridItem="PersonListItemDto"
                    Items="@persons.AsQueryable()"
                    Style="width: 100%;">
        <PropertyColumn Property="@(p => p.Id)" Title="Id" />
        <PropertyColumn Property="@(p => p.LastName)" Title="Last name" />
        <PropertyColumn Property="@(p => p.FirstName)" Title="First name" />
        <PropertyColumn Property="@(p => p.BirthDate)" Title="Birth date" Format="yyyy-MM-dd" />
    </FluentDataGrid>
</FluentStack>

@code {
    private List<PersonListItemDto> persons = [];
    private bool isLoading;

    private async Task LoadPersonsAsync()
    {
        isLoading = true;
        try
        {
            var result = await PersonService.GetPersonsAsync(name: null);
            persons = [.. result];
        }
        finally
        {
            isLoading = false;
        }
    }
}
