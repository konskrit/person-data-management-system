@page "/"
@using PersonDataManagementSystem.Application.Dtos
@using PersonDataManagementSystem.Application.Interfaces
@using PersonDataManagementSystem.Web.Components
@inject IPersonService PersonService
@inject IDialogService DialogService

<PageTitle>Persons</PageTitle>

<FluentStack Orientation="Orientation.Vertical" VerticalGap="16">
    <FluentLabel Typo="Typography.Header">Persons</FluentLabel>

    <form @onsubmit="LoadPersonsAsync" @onsubmit:preventDefault>
        <FluentStack Orientation="Orientation.Vertical" VerticalGap="4">
            <FluentLabel ForId="name-filter">Name</FluentLabel>
            <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="12" VerticalAlignment="VerticalAlignment.Center">
                <FluentTextInput Id="name-filter"
                                 @bind-Value="nameFilter"
                                 Placeholder="Optional search"
                                 Immediate="true"
                                 ImmediateDelay="0"
                                 Style="min-width: 16rem;" />
                <FluentButton Appearance="ButtonAppearance.Primary"
                              ButtonType="ButtonType.Button"
                              Disabled="@isLoading"
                              OnClick="LoadPersonsAsync">
                    @(isLoading ? "Loading..." : "Load persons")
                </FluentButton>
            </FluentStack>
        </FluentStack>
    </form>

    <FluentDataGrid TGridItem="PersonListItemDto"
                    Items="@persons.AsQueryable()"
                    ShowHover="true"
                    OnRowClick="OpenPersonDetailAsync"
                    Style="width: 100%;">
        <PropertyColumn Property="@(p => p.Id)" Title="Id" />
        <PropertyColumn Property="@(p => p.LastName)" Title="Last name" />
        <PropertyColumn Property="@(p => p.FirstName)" Title="First name" />
        <PropertyColumn Property="@(p => p.BirthDate)" Title="Birth date" Format="yyyy-MM-dd" />
    </FluentDataGrid>
</FluentStack>

@code {
    private List<PersonListItemDto> persons = [];
    private string? nameFilter;
    private bool isLoading;

    private async Task LoadPersonsAsync()
    {
        isLoading = true;
        try
        {
            var result = await PersonService.GetPersonsAsync(nameFilter);
            persons = [.. result];
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task OpenPersonDetailAsync(FluentDataGridRow<PersonListItemDto> row)
    {
        if (row.Item is null)
            return;

        var result = await DialogService.ShowDialogAsync<PersonDetailDialog>(options =>
        {
            options.Modal = false;
            options.Parameters.Add(nameof(PersonDetailDialog.PersonId), row.Item.Id);
        });

        if (!result.Cancelled)
            await LoadPersonsAsync();
    }
}
